generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String           @id @default(cuid())
  steamId         String           @unique
  displayName     String
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  lastLogin       DateTime         @default(now())
  aegisActions    AegisAction[]
  aegisApprovals  AegisApproval[]
  aegisEmbeddings AegisEmbedding[]
  aegisLogs       AegisLog[]
  aegisMemories   AegisMemory[]
  aegisRuns       AegisRun[]
  aegisTraces     AegisTrace[]
  chatSessions    ChatSession[]
  chatMessages    ChatMessage[]
  inventoryItems  InventoryItem[]
}

model Item {
  id                       String                      @id @default(cuid())
  marketHashName           String                      @unique
  name                     String
  weapon                   String?
  skin                     String?
  category                 String
  rarity                   String?
  exterior                 String?
  imageUrl                 String?
  isActive                 Boolean                     @default(true)
  isWatched                Boolean                     @default(false)
  notes                    String?
  createdAt                DateTime                    @default(now())
  type                     String?
  candlesticks             Candlestick[]
  groups                   ItemGroup[]
  intelligenceCacheEntries IntelligenceProviderCache[]
  intelligenceObservations IntelligenceObservation[]
  intelligenceQueueItems   IntelligenceQueueItem[]
  intelligenceSignals      IntelligenceSignal[]
  inventoryItems           InventoryItem[]
  priceSnapshots           PriceSnapshot[]
}

model PriceSnapshot {
  id        Int      @id @default(autoincrement())
  itemId    String
  price     Float
  volume    Int?
  source    String   @default("pricempire")
  timestamp DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, timestamp])
}

model Candlestick {
  id        Int      @id @default(autoincrement())
  itemId    String
  interval  String
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Int      @default(0)
  timestamp DateTime
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, interval, timestamp])
  @@index([itemId, interval, timestamp])
}

model InventoryItem {
  id            String    @id @default(cuid())
  userId        String
  itemId        String
  assetId       String    @unique
  floatValue    Float?
  paintSeed     Int?
  stickers      String?
  acquiredAt    DateTime  @default(now())
  acquiredPrice Float?
  soldAt        DateTime?
  soldPrice     Float?
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now())
  aegisRuns AegisRun[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String       @id @default(cuid())
  userId    String
  sessionId String?
  role      String
  content   String
  metadata  String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model AegisRun {
  id                String          @id @default(cuid())
  userId            String
  sessionId         String?
  status            String          @default("queued")
  provider          String?
  agentMode         String?
  reasoningDepth    String?
  openRouterModelId String?
  deepResearch      Boolean         @default(false)
  input             String
  finalResponse     String?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  actions           AegisAction[]
  approvals         AegisApproval[]
  logs              AegisLog[]
  session           ChatSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  traces            AegisTrace[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sessionId])
}

model AegisTrace {
  id        String   @id @default(cuid())
  runId     String
  userId    String
  sequence  Int
  stage     String?
  type      String
  message   String?
  payload   Json     @default("{}")
  error     String?
  createdAt DateTime @default(now())
  run       AegisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
}

model AegisLog {
  id        String   @id @default(cuid())
  runId     String
  userId    String
  sequence  Int
  stage     String?
  level     String   @default("info")
  type      String
  message   String
  payload   Json     @default("{}")
  error     String?
  createdAt DateTime @default(now())
  run       AegisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@index([userId, createdAt])
  @@index([level, type])
}

model AegisAction {
  id             String         @id @default(cuid())
  runId          String
  userId         String
  tool           String
  status         String         @default("proposed")
  risk           String         @default("low")
  input          Json           @default("{}")
  inputPreview   String?
  output         Json           @default("{}")
  outputPreview  String?
  error          String?
  idempotencyKey String?
  proposedAt     DateTime       @default(now())
  approvedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approval       AegisApproval?
  run            AegisRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([runId, status])
  @@index([userId, createdAt])
  @@index([tool])
}

model AegisApproval {
  id          String      @id @default(cuid())
  runId       String
  actionId    String      @unique
  userId      String
  status      String      @default("pending")
  request     Json        @default("{}")
  response    Json        @default("{}")
  expiresAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  action      AegisAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  run         AegisRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([runId, status])
  @@index([userId, status])
  @@index([expiresAt])
}

model AegisMemory {
  id          String           @id @default(cuid())
  userId      String
  title       String
  content     String
  kind        String           @default("preference")
  tags        Json             @default("[]")
  source      String           @default("chat")
  confidence  Float            @default(0.5)
  contentHash String?
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  embeddings  AegisEmbedding[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentHash])
  @@index([userId, archivedAt, updatedAt])
  @@index([kind])
}

model AegisEmbedding {
  id          String      @id @default(cuid())
  memoryId    String
  userId      String
  provider    String      @default("gemini")
  model       String      @default("gemini-embedding-2")
  dimensions  Int         @default(1536)
  vectorJson  String
  contentHash String
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  memory      AegisMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, model, contentHash])
  @@index([userId, model])
  @@index([contentHash])
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  type      String
  status    String
  itemCount Int      @default(0)
  duration  Int?
  error     String?
  timestamp DateTime @default(now())
}

model MarketCapSnapshot {
  id             String   @id @default(cuid())
  totalMarketCap Float
  totalListings  Int?
  provider       String   @default("youpin")
  topItems       String?
  timestamp      DateTime @default(now())

  @@index([provider, timestamp])
}

model AppSettings {
  id                      String    @id @default("singleton")
  activeMarketSource      String    @default("csfloat")
  csgotraderSubProvider   String    @default("csfloat")
  activeAIProvider        String    @default("gemini-flash")
  openAiApiKey            String?
  geminiApiKey            String?
  anthropicApiKey         String?
  openRouterApiKey        String?
  nineRouterApiKey        String?
  csfloatApiKey           String?
  priceRefreshIntervalMin Int       @default(15)
  watchlistOnly           Boolean   @default(true)
  googleAccessToken       String?
  googleRefreshToken      String?
  googleTokenExpiry       DateTime?
  // DB-based sync lock to prevent concurrent CSFloat access across serverless instances
  syncInProgress          Boolean   @default(false)
  syncStartedAt           DateTime?
}

/// Persists the csgotrader.app bulk price JSON so cold starts don't re-fetch.
/// Singleton row (id="singleton"). The `data` column holds the full JSON blob.
model BulkPriceCache {
  id        String   @id @default("singleton")
  data      String // JSON blob of the full csgotrader.app/csfloat.json response
  updatedAt DateTime @default(now())
}

model TopMoversCache {
  id        String   @id @default("singleton")
  gainers   String // JSON array of top 5 gainers
  losers    String // JSON array of top 5 losers
  source    String   @default("csfloat")
  updatedAt DateTime @default(now())
}

/// Stores the last-request timestamp (ms since epoch) per API queue.
/// Used by the global rate limiter so concurrent serverless isolates
/// respect the same per-provider request cadence.
model RateLimitState {
  queueName     String @id
  lastRequestMs Float  @default(0)
}

model WatchlistGroup {
  id        String      @id @default(cuid())
  name      String
  color     String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  items     ItemGroup[]

  @@unique([name])
}

model ItemGroup {
  id      String         @id @default(cuid())
  itemId  String
  groupId String
  item    Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group   WatchlistGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([itemId, groupId])
  @@index([itemId])
  @@index([groupId])
}

model IntelligenceConfig {
  id                          String    @id @default("default")
  liveScmEnabled              Boolean   @default(false)
  circuitBreakerUntil         DateTime?
  consecutiveProviderFailures Int       @default(0)
  lastRunAt                   DateTime?
  lastError                   String?
  requestBudget               Json      @default("{}")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model IntelligenceQueueItem {
  id             String    @id @default(cuid())
  itemId         String
  nextRunAt      DateTime
  priority       Int       @default(0)
  tier           String    @default("standard")
  attempts       Int       @default(0)
  lastError      String?
  lockedUntil    DateTime?
  lastFetchedAt  DateTime?
  disabledReason String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId])
  @@index([nextRunAt])
  @@index([tier])
  @@index([status])
  @@index([itemId])
  @@index([status, nextRunAt, priority])
}

model IntelligenceProviderCache {
  id                String    @id @default(cuid())
  provider          String
  lookupType        String
  lookupKey         String
  itemId            String?
  rawPayload        Json      @default("{}")
  normalizedPayload Json      @default("{}")
  fetchedAt         DateTime  @default(now())
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  item              Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([provider, lookupType, lookupKey])
  @@index([provider, lookupType, lookupKey])
  @@index([itemId])
}

model IntelligenceObservation {
  id               Int      @id @default(autoincrement())
  itemId           String
  provider         String
  observedAt       DateTime @default(now())
  floorPriceCents  Int?
  medianPriceCents Int?
  listingCount     Int?
  volume           Int?
  confidence       Float    @default(0)
  freshness        String   @default("fresh")
  status           String   @default("observed")
  reasons          Json     @default("[]")
  rawPayload       Json     @default("{}")
  createdAt        DateTime @default(now())
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([observedAt])
  @@index([status])
  @@index([provider, observedAt])
}

model IntelligenceSignal {
  id            String                    @id @default(cuid())
  itemId        String
  signalType    String
  status        String                    @default("active")
  confidence    Float                     @default(0)
  detectedAt    DateTime                  @default(now())
  lastSeenAt    DateTime                  @default(now())
  staleAt       DateTime?
  priceCents    Int?
  baselineCents Int?
  deltaCents    Int?
  reasons       Json                      @default("[]")
  metadata      Json                      @default("{}")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  events        IntelligenceSignalEvent[]
  item          Item                      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, signalType, status])
  @@index([itemId])
  @@index([signalType])
  @@index([status])
  @@index([detectedAt])
}

model IntelligenceSignalEvent {
  id            Int                @id @default(autoincrement())
  signalId      String
  itemId        String
  eventType     String
  signalType    String
  occurredAt    DateTime           @default(now())
  confidence    Float              @default(0)
  priceCents    Int?
  baselineCents Int?
  deltaCents    Int?
  reasons       Json               @default("[]")
  metadata      Json               @default("{}")
  signal        IntelligenceSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@index([itemId])
  @@index([signalType])
  @@index([occurredAt])
}
