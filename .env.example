# ─── DATABASE ────────────────────────────────────────────
# Local development (leave TURSO vars empty to use this)
DATABASE_URL="file:./dev.db"
# Production (Turso) — set these to use remote database
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ─── STEAM ───────────────────────────────────────────────
STEAM_API_KEY=""
ALLOWED_STEAM_ID=""

# ─── MARKET DATA PROVIDERS ───────────────────────────────
PRICEMPIRE_API_KEY=""
CSFLOAT_API_KEY=""

# ─── AI: Google OAuth (Gemini) ───────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI: API Keys ───────────────────────────────────────
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="~openai/gpt-latest"
NINEROUTER_API_KEY=""
NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_MODEL="cc/claude-opus-4-7"

# ─── SECURITY ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
TOKEN_ENCRYPTION_KEY=""

# ─── CRON AUTH ───────────────────────────────────────────
# Shared by Vercel Cron and external schedulers such as cron-job.org.
# Send as `Authorization: Bearer <value>` or `x-cron-secret: <value>`.
CRON_SECRET=""
